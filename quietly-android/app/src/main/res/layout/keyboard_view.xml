<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_bg"
    android:orientation="vertical"
    android:paddingBottom="6dp">

    <!-- TIER 1: Dedicated Full-Width AI Suggestion Bar (All 3 suggestions clearly visible) -->
    <LinearLayout
        android:id="@+id/tier_suggestions"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/strip_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:id="@+id/chips_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/chip_border" />

    <!-- TIER 2: Controls Strip (Suggest, Tone, Mic, Context Hint) -->
    <LinearLayout
        android:id="@+id/tier_controls"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@color/strip_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- AI Trigger Button -->
        <TextView
            android:id="@+id/btn_ai_suggest"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/chip_background_sparkle"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="✨ Suggest"
            android:textColor="@color/on_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Tone Switcher Chip -->
        <TextView
            android:id="@+id/btn_tone"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/chip_background"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="🌟 Warm"
            android:textColor="@color/chip_sparkle"
            android:textSize="11sp" />

        <!-- Voice Typing Mic Chip -->
        <TextView
            android:id="@+id/btn_voice"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/chip_background"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="🎙️"
            android:textColor="@color/on_primary"
            android:textSize="12sp" />

        <!-- Live Context Preview or Status Text -->
        <TextView
            android:id="@+id/tv_context_preview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="💡 Tap ✨ Suggest to generate 3 replies"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/chip_border" />

    <!-- Keyboard Keys Area -->
    <LinearLayout
        android:id="@+id/keys_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="6dp">

        <!-- Row 1: Q W E R T Y U I O P -->
        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp" />

        <!-- Row 2: A S D F G H J K L -->
        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- Row 3: Shift, Z X C V B N M, Backspace -->
        <LinearLayout
            android:id="@+id/row3"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp" />

        <!-- Row 4: ?123, Comma, Space, Period, Enter -->
        <LinearLayout
            android:id="@+id/row4"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp" />
    </LinearLayout>
</LinearLayout>
