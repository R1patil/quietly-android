<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_bg"
    android:orientation="vertical"
    android:paddingBottom="6dp">

    <!-- AI Suggestion & Tone Strip -->
    <LinearLayout
        android:id="@+id/suggestion_header"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/strip_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- AI Trigger Button -->
        <TextView
            android:id="@+id/btn_ai_suggest"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/chip_background_sparkle"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="✨ Suggest"
            android:textColor="@color/on_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Tone Switcher Chip -->
        <TextView
            android:id="@+id/btn_tone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/chip_background"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="🌟 Warm"
            android:textColor="@color/chip_sparkle"
            android:textSize="12sp" />

        <!-- Voice Typing Mic Chip -->
        <TextView
            android:id="@+id/btn_voice"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/chip_background"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="🎙️"
            android:textColor="@color/on_primary"
            android:textSize="14sp" />

        <!-- Scrollable AI Suggestions Container -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chips_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/chip_border" />

    <!-- Keyboard Keys Area -->
    <LinearLayout
        android:id="@+id/keys_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="6dp">

        <!-- Row 1: Q W E R T Y U I O P -->
        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp" />

        <!-- Row 2: A S D F G H J K L -->
        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- Row 3: Shift, Z X C V B N M, Backspace -->
        <LinearLayout
            android:id="@+id/row3"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp" />

        <!-- Row 4: ?123, Comma, Space, Period, Enter -->
        <LinearLayout
            android:id="@+id/row4"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp" />
    </LinearLayout>
</LinearLayout>
